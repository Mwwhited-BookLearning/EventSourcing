<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EventStore.Abstractions\EventStore.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cel.NET" />
    <PackageReference Include="Jsonata.Net.Native" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- ADR-080 (dependency-vulnerability scanning) found Cel.NET's own
         transitive graph pulling System.Drawing.Common 4.7.0 (GHSA-rxg9-
         xrhp-64gj, critical). A direct override bumps NuGet's higher-
         version-wins resolution to a patched release; nothing in this
         project actually uses System.Drawing at all. -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
