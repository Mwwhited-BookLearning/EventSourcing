<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-only driver, same standing as EventStore.Benchmarks: reuses DevIdp's seeded client key
         pairs and the shared DPoP proof code so it authenticates exactly like the e2e suite does. -->
    <ProjectReference Include="..\EventStore.Dpop\EventStore.Dpop.csproj" />
    <ProjectReference Include="..\EventStore.DevIdp\EventStore.DevIdp.csproj" />
  </ItemGroup>

</Project>
