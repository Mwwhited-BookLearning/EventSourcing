<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-101: the promoted, framework-level home for the PlantUML-native
       (Option G1) user-flow interpreter, docs/comparisons/user-flow-dsl.md.
       Read-side only: references EventStore.Projections.Abstractions/.Host
       for IProjection<T>/ProjectionHost, nothing from the write side
       (EventStore.Router/.Persistence/.Domain): the flow engine never
       needs write-side fold internals, only the same public Follow-derived
       merged snapshot every other projection already works from. -->
  <ItemGroup>
    <ProjectReference Include="..\EventStore.Projections.Abstractions\EventStore.Projections.Abstractions.csproj" />
    <ProjectReference Include="..\EventStore.Projections.Host\EventStore.Projections.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- Same real, verified versions as spikes/user-flow-dsl/AntlrCustomDslSpike
         (MIT/BSD-3-Clause, checked that session). Antlr4BuildTasks compiles
         Grammar/PlantUmlActivityDiagram.g4 via the real ANTLR4 Java tool as
         an MSBuild step (downloads its own JRE, no local Java/Docker setup
         needed) into a Listener-pattern parser, not Visitor, per direct
         request. -->
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Grammar\PlantUmlActivityDiagram.g4">
      <Listener>true</Listener>
      <Visitor>false</Visitor>
    </Antlr4>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
