<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EventStore.SchemaRegistry\EventStore.SchemaRegistry.csproj" />
    <ProjectReference Include="..\EventStore.Flows\EventStore.Flows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-101: the real, checked-in diagram source AND the executing
         flow definition are the SAME file, embedded so the assembly can
         read it at runtime, never copied/re-typed into a C# string. -->
    <EmbeddedResource Include="..\..\docs\domains\clinical-trials-device-telemetry\features\adverse-event-capture-and-review.puml">
      <LogicalName>Samples.Vitals.adverse-event-capture-and-review.puml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\domains\clinical-trials-device-telemetry\features\intraoperative-monitoring-and-alert-response.puml">
      <LogicalName>Samples.Vitals.intraoperative-monitoring-and-alert-response.puml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Worked proving-ground example, explicitly NOT part of the
         framework (ADR-030), never a published package, same posture
         Samples.Orders.Projections already established. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
