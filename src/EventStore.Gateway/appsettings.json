{
  "Spiffe": {
    "TrustDomain": "eventstore.local",
    "ServicePath": "/eventstore/gateway"
  },
  "ReverseProxy": {
    "Routes": {
      "publish-route": {
        "ClusterId": "host-cluster",
        "Order": 0,
        "RateLimiterPolicy": "publish-token-bucket",
        "Match": { "Path": "/publish/{**catch-all}" }
      },
      "follow-route": {
        "ClusterId": "host-cluster",
        "Order": 0,
        "RateLimiterPolicy": "follow-concurrency",
        "Match": { "Path": "/follow/{**catch-all}" }
      },
      "host-route": {
        "ClusterId": "host-cluster",
        "Order": 10,
        "RateLimiterPolicy": "general-sliding-window",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "host-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7443/" }
        }
      }
    }
  },
  "RateLimiting": {
    "PublishTokenLimit": 20,
    "PublishTokensPerPeriod": 5,
    "PublishReplenishmentPeriod": "00:00:01",
    "FollowConcurrencyLimit": 5,
    "GeneralPermitLimit": 60,
    "GeneralWindow": "00:01:00",
    "GeneralSegmentsPerWindow": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
