<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately NO reference to EventStore.Persistence, EventStore.Host.Core,
         or any EventStore.Host.(Provider) project. See docs/06-solution-structure.md:
         "its only dependency on the write side is an HTTP client calling
         QUERY /follow/(event-type), enforced by the project reference graph
         itself, not just a convention." -->
    <ProjectReference Include="..\EventStore.Projections.Abstractions\EventStore.Projections.Abstractions.csproj" />
    <ProjectReference Include="..\EventStore.Dpop\EventStore.Dpop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- ADR-080 (dependency-vulnerability scanning) found this pulling
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q, high). A
         direct override bumps NuGet's higher-version-wins resolution to a
         patched release. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
