<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireSharedProject>true</IsAspireSharedProject>
    <!-- ADR-062: Aspire's own convention for a shared project is to be
         copied per-solution, not distributed via NuGet, IsAspireSharedProject
         above is that same signal; this mirrors it explicitly for the
         packaging build-time check. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR-088: EventStore.Domain is a true leaf project (zero
         dependencies of its own), so referencing it here to reach
         DuplexInstrumentation's shared Meter/ActivitySource introduces no
         circularity risk. -->
    <ProjectReference Include="..\EventStore.Domain\EventStore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Microsoft.Extensions.Http.Resilience (Polly v8 underneath) removed
         from this project's dependencies. See docs/bugs/framework/service/
         follow-client-faults-under-default-http-resilience-timeout.md and
         docs/references.md's own "considered and rejected" entry: its
         blanket 10s per attempt / 30s total default timeout is
         fundamentally incompatible with this design's own genuinely
         long-lived streaming HTTP calls (the Follow API's SSE-style tail),
         and every real cross-service retry need this project actually has
         already owns its own purpose-built, correctly-tuned mechanism
         (ADR-033's outbox/inbox, ADR-060's webhook dispatcher, EventTailReader
         and FollowClient's own reconnect loops, EF Core's own
         EnableRetryOnFailure). A generic HTTP-level wrapper was never adding
         real value here, only an unexamined Aspire template default.
         Removed rather than retuned, also given Polly's new Open Source
         Maintenance Fee (thepollyproject.org, 2026-07-14, direct request). -->
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Direct request: process-level metrics (CPU%, working set, thread/
         handle count), a "useful application detail" beyond AspNetCore/Http/
         Runtime above. Verified against nuget.org before adding: this
         package has never shipped a stable release (still 1.17.0-rc.1 as of
         this pass, every earlier version alpha/beta too), the one
         inconsistency with every other OTel package here being a real,
         non-prerelease 1.17.0. Added anyway, since there is no stable
         alternative for process metrics and the API surface has been
         release-candidate for a long time. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.17.0-rc.1" />
  </ItemGroup>

</Project>
