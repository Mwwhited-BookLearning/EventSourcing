<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ADR-062: dev-only mock IdP (docs/06-solution-structure.md's own
         "dev-only" label), never a published package, a real deployment
         brings its own IdP. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-088's shared DuplexInstrumentation only, already a transitive
         dependency via EventStore.ServiceDefaults below, added explicitly
         for clarity. Still never EventStoreContext/Persistence/SchemaRegistry
         (this project's own "no core engine" boundary, RbacProjectionWorker.cs's
         own comment), since none of those live in this leaf project. -->
    <ProjectReference Include="..\EventStore.Domain\EventStore.Domain.csproj" />
    <ProjectReference Include="..\EventStore.ServiceDefaults\EventStore.ServiceDefaults.csproj" />
    <ProjectReference Include="..\EventStore.Dpop\EventStore.Dpop.csproj" />
    <ProjectReference Include="..\EventStore.TicketExchange\EventStore.TicketExchange.csproj" />
    <ProjectReference Include="..\EventStore.Ucan\EventStore.Ucan.csproj" />
    <ProjectReference Include="..\EventStore.Projections.Host\EventStore.Projections.Host.csproj" />
  </ItemGroup>

</Project>
