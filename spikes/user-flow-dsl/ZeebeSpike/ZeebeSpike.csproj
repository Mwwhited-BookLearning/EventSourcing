<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike only, docs/comparisons/user-flow-dsl.md Option D. Not part of
       EventStore.slnx on purpose: this is throwaway research code proving
       the shape works, not a production dependency. Needs a real Zeebe
       broker running (see this project's own README.md for the docker run
       command); there is no embedded/local dev-server equivalent here,
       unlike TemporalSpike. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="zb-client" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real BPMN 2.0 process definition, a standalone standard XML
         file, never an inline C# string literal, per direct request. -->
    <Content Include="Bpmn\AdverseEventReview.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
