<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike-adjacent tooling, not a spike itself: validates the real text
       file formats the spikes in this folder use against their own real,
       official schemas (checked in under Schemas/, real OMG XSD downloads,
       never re-typed). Not part of EventStore.slnx on purpose. See this
       project's own README.md for exactly what is and isn't covered, and
       why (PlantUML and the custom ANTLR grammar have no formal schema to
       validate against at all). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Schemas\**\*.xsd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
