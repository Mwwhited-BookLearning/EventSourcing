<Project>

  <!-- ADR-062: every EventStore.* project (excluding provider glue and
       samples) becomes a published NuGet package of the same name. Setting
       PackageId once here via $(MSBuildProjectName) gives every project
       its own correct PackageId automatically, matching this ADR's own
       "EventStore.Core, EventStore.GraphQL, ... becomes a published NuGet
       package of the same name" text literally, without a per-project
       line to keep in sync across ~35 projects. Version is a single
       SemVer 2.0.0 (semver.org, ADR-062) number shared by every package in
       this repo, bumped together, 0.y.z per SemVer's own "initial
       development" meaning, since public API surface discipline (this
       ADR's own new Consequence) is not yet enforced anywhere. Test
       projects need no opt-out: the Microsoft.NET.Test.Sdk MSBuild targets
       already set IsPackable=false for any project referencing them. -->
  <PropertyGroup>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Version>0.1.0</Version>
    <Authors>OoBDev</Authors>
    <Company>OoBDev</Company>
    <Product>Duplex</Product>
    <Description>Duplex event-sourcing framework -- $(MSBuildProjectName)</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/Mwwhited-BookLearning/EventSourcing.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Phase 5 (docs/architecture-design-guidelines.md): a general .NET
       analyzer baseline plus this repo's own bespoke rules, all at
       "warning" severity per direct request; see .editorconfig for
       the severity overrides this depends on, and BannedSymbols.txt for
       the AutoMapper/Newtonsoft.Json guardrail (ADR-041). Applies to
       every project via Directory.Build.props, the same "one line here,
       not N lines per project" reasoning this file already uses above
       for PackageId. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- AD0001 ("an analyzer threw") does not respond to a .editorconfig
         dotnet_diagnostic severity override the way an ordinary analyzer
         diagnostic does; verified via two real full-solution rebuilds,
         confirmed still firing after setting its severity to none in
         .editorconfig. NoWarn is the mechanism that actually works.
         Suppressing the five specific StyleCop.Analyzers 1.1.118 rules
         that crash on record declarations (see .editorconfig's own
         comment) is the real fix; this is the necessary companion for
         the crash notice itself, which carries no actionable content of
         its own. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

</Project>
