{
  "name": "duplex-client-web-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/reference-app --",
    "dev:vitals": "npm run dev:vitals --workspace=packages/reference-app --",
    "dev:meridian": "npm run dev:meridian --workspace=packages/reference-app --",
    "build": "npm run build --workspace=packages/mvvm-client && npm run build --workspace=packages/reference-app",
    "build:offline-player": "npm run build:offline-player --workspace=packages/reference-app",
    "embed:offline-bundle": "npm run embed:offline-bundle --workspace=packages/reference-app",
    "bridge:reference": "npm run bridge:reference --workspace=packages/reference-app",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=packages/reference-app",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "ws": "^8.21.3"
  }
}
