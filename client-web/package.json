{
  "name": "duplex-client-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vitals": "vite --mode vitals",
    "dev:meridian": "vite --mode meridian",
    "build": "vue-tsc -b && vite build",
    "build:offline-player": "vite build --config vite.offline-player.config.ts",
    "embed:offline-bundle": "node scripts/embed-bundle.mjs",
    "bridge:reference": "node native-bridge-reference/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "ws": "^8.21.3"
  }
}
