# `npm run dev:vitals` (--mode vitals) -- layers on top of
# .env.development, pre-configuring this instance for the Vitals
# proving-ground domain (docs/domains/clinical-trials-device-telemetry)
# the same way EventStore.AppHost/AppHost.cs's own clientWebVitals
# resource does via WithEnvironment, for standalone use without AppHost.
VITE_APP_ID=trial1
VITE_ENTITY_TYPE=patient
VITE_EVENT_TYPE=PatientScreened
VITE_ENTITY_ID_FIELD=subjectId
