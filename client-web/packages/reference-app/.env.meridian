# `npm run dev:meridian` (--mode meridian) -- layers on top of plain
# `.env` (NOT `.env.development` -- Vite only loads that file when the
# mode is literally "development"; under --mode meridian it loads .env
# + this file + their .local variants, per .env's own header comment),
# pre-configuring this instance for the Meridian
# proving-ground domain (docs/domains/digital-identity-kyc) the same way
# EventStore.AppHost/AppHost.cs's own clientWebMeridian resource does via
# WithEnvironment, for standalone use without AppHost.
VITE_APP_ID=kyc
VITE_ENTITY_TYPE=applicantidentity
VITE_EVENT_TYPE=IdentityClaimSubmitted
VITE_ENTITY_ID_FIELD=applicantId
